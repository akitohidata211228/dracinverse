{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/dramas/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/stream/*.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
